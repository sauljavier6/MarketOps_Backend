PORT=4580
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=marketops
DB_USER=postgres
DB_PASSWORD=
DB_LOGGING=false

# Mercado Libre application
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:4580/api/marketplaces/mercadolibre/callback
FRONTEND_URL=http://localhost:5173

# 32-byte base64 key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Used to sign OAuth state values.
OAUTH_STATE_SECRET=

# Supplier Discovery - Brave Search API
# Optional until you want automatic supplier discovery.
BRAVE_SEARCH_API_KEY=
