PORT=4580
DB_HOST=127.0.0.1
DB_PORT=5432
DB_NAME=marketops
DB_USER=postgres
DB_PASSWORD=
DB_LOGGING=false

# Mercado Libre application
MELI_CLIENT_ID=
MELI_CLIENT_SECRET=
MELI_REDIRECT_URI=http://localhost:4580/api/marketplaces/mercadolibre/callback
FRONTEND_URL=http://localhost:5173

# 32-byte base64 key. Generate with:
# node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
TOKEN_ENCRYPTION_KEY=

# Used to sign OAuth state values.
OAUTH_STATE_SECRET=

# Supplier catalog - SYSCOM Developers API v1
# Create credentials at https://developers.syscom.mx/ after signing in as a distributor.
SYSCOM_CLIENT_ID=
SYSCOM_CLIENT_SECRET=

# Legacy supplier discovery. Automatic Brave sourcing is disabled in the active Radar flow.
BRAVE_SEARCH_API_KEY=
